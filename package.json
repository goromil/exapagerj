{
  "name": "exapager",
  "displayName": "ExaPager — Large File Viewer",
  "description": "View multi-GB text files — zero Python dependency.",
  "version": "0.1.0",
  "publisher": "gorom",
  "engines": {
    "vscode": "^1.74.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "files": [
    "out"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "exapager.open",
        "title": "ExaPager: Open Large File",
        "icon": "$(preview)"
      },
      {
        "command": "exapager.openActive",
        "title": "ExaPager: Open Active File"
      },
      {
        "command": "exapager.previewFile",
        "title": "ExaPager: Preview File",
        "icon": "$(preview)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "exapager.previewFile",
          "when": "resourceScheme == file",
          "group": "exapager@1"
        }
      ],
      "editor/context": [
        {
          "command": "exapager.previewFile",
          "when": "resourceScheme == file",
          "group": "exapager@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && npx mocha --ui tdd out/test/utils.test.js",
    "test:vscode": "npm run compile && node ./out/test/runTest.js",
    "coverage": "npm run compile && npx c8 --reporter=lcov --reporter=text npx mocha --ui tdd out/test/utils.test.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.74.0",
    "@vscode/test-electron": "^2.3.0",
    "c8": "^9.0.0",
    "mocha": "^10.2.0",
    "typescript": "^5.0.0"
  }
}
